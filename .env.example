# ============================================================
# JARVIS configuration
# Copy this file to .env and fill in your key.
#   Windows PowerShell:  copy .env.example .env
# Only GEMINI_API_KEY is strictly required; every other value
# below shows its built-in default and can be left as-is.
# ============================================================

# --- Identity ---
ASSISTANT_NAME=Jarvis

# --- Gemini (required) ---
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# --- Wake word (optional) ---
WAKE_WORD_ENABLED=false
WAKE_WORD=jarvis

# --- Speech-to-text ---
# STT_BACKEND: local (faster-whisper) | recognition (Google Web Speech)
STT_BACKEND=local
# STT_MODEL: tiny | base.en | small | medium | large-v3
STT_MODEL=base.en
STT_COMPUTE_TYPE=int8

# --- Voice activity detection ---
# SILENCE_THRESHOLD is a FLOOR, not the trigger level. JARVIS measures your room
# noise and triggers at max(this floor, 5 x noise floor). Leave it small; raise it
# only if fan noise keeps waking the assistant. Speech RMS is typically 0.01-0.05.
SILENCE_THRESHOLD=0.004
END_SILENCE_DURATION=0.8
MAX_RECORDING_DURATION=20.0
MIN_RECORDING_DURATION=0.4
SAMPLE_RATE=16000
# Empty means the system default input device.
MICROPHONE_DEVICE=

# --- Text-to-speech ---
# TTS_ENGINE: edge | pyttsx3 | none
TTS_ENGINE=edge
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=175
TTS_VOLUME=1.0

# --- Safety ---
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE_ACTIONS=true
# CONFIRMATION_LEVEL: SAFE | CAUTION | SENSITIVE | DESTRUCTIVE
CONFIRMATION_LEVEL=DESTRUCTIVE
MAX_TOOL_RETRIES=2
TOOL_TIMEOUT_SECONDS=60

# --- Browser automation ---
# false = watch the Playwright window on screen.
BROWSER_HEADLESS=false

# --- Memory / context ---
MAX_RECENT_MESSAGES=12
CONTEXT_SUMMARY_THRESHOLD=20

# --- Logging ---
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
DEBUG=false
